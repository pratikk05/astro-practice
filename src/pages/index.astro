---
import Layout from "../layouts/Layout.astro";

const videoUrl = "https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260826_041744_63efcd78-bf7d-4039-99e2-2461e8a61903.mp4";
---

<Layout title="Mainframe® — Creative company for what’s next">
	<div class="relative min-h-svh overflow-hidden bg-[#101313] text-white">
		<video class="hero-video fixed inset-0 z-0 h-full w-full object-cover" style="object-position: 70% center" data-scrub-video muted playsinline preload="auto" aria-hidden="true">
			<source src={videoUrl} type="video/mp4" />
		</video>
		<div class="hero-shade pointer-events-none fixed inset-0 z-[1]" aria-hidden="true"></div>

		<header class="fixed inset-x-0 top-0 z-10 flex items-center justify-between px-5 py-4 sm:px-8 sm:py-5">
			<a class="brand relative z-20 flex items-center gap-3 text-white" href="#top" aria-label="Mainframe home">
				<span class="font-brand text-[21px] tracking-tight sm:text-[26px]">Mainframe<sup>®</sup></span>
				<span class="select-none text-[25px] leading-none tracking-[-0.02em] sm:text-[30px]" aria-hidden="true">✳︎</span>
			</a>
			<nav class="desktop-nav absolute left-1/2 hidden -translate-x-1/2 items-center text-[23px] md:flex" aria-label="Main navigation">
				<a href="#labs">Labs</a><span aria-hidden="true">, </span><a href="#studio">Studio</a><span aria-hidden="true">, </span><a href="#openings">Openings</a><span aria-hidden="true">, </span><a href="#shop">Shop</a>
			</nav>
			<a class="desktop-contact hidden text-[23px] underline underline-offset-2 transition-opacity hover:opacity-60 md:block" href="mailto:hello@mainframe.co">Get in touch</a>
			<button class="menu-toggle relative z-20 flex h-10 w-10 flex-col items-center justify-center gap-[5px] md:hidden" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
				<span class="hamburger-bar h-[2px] w-6 bg-white"></span><span class="hamburger-bar h-[2px] w-6 bg-white"></span><span class="hamburger-bar h-[2px] w-6 bg-white"></span>
			</button>
		</header>

		<div id="mobile-menu" class="mobile-menu fixed inset-0 z-[9] flex flex-col justify-center gap-8 bg-black/90 px-8 backdrop-blur-md md:hidden" aria-hidden="true" inert data-mobile-menu>
			<nav class="flex flex-col items-start gap-8 text-[32px] font-medium" aria-label="Mobile navigation">
				<a href="#labs">Labs</a><a href="#studio">Studio</a><a href="#openings">Openings</a><a href="#shop">Shop</a><a class="underline underline-offset-4" href="mailto:hello@mainframe.co">Get in touch</a>
			</nav>
		</div>

		<main id="top" class="relative z-[2] flex min-h-svh flex-col justify-end overflow-hidden px-5 pb-12 pt-28 sm:px-8 md:justify-center md:px-10 md:pb-0">
			<section class="relative z-10 w-full max-w-xl" aria-label="Mainframe introduction">
				<p class="intro-blur pointer-events-none mb-5 select-none text-[clamp(18px,4vw,26px)] font-normal leading-[1.3] text-white sm:mb-6">Hey there, meet A.R.I.A,<br />Mainframe's Adaptive Response Interface Agent</p>
				<p class="mb-5 min-h-[3.5em] text-[clamp(18px,4vw,26px)] font-normal leading-[1.35] text-white sm:mb-6" aria-live="polite"><span data-typewriter data-text="Glad you stopped in. Good taste tends to find us. Now, what are we building?"></span><span class="type-cursor" aria-hidden="true" data-type-cursor></span></p>
				<div class="action-pills flex flex-wrap gap-y-1" data-action-pills>
					<a class="pill pill-light" href="mailto:hello@mainframe.co?subject=An%20idea%20for%20Mainframe">Pitch us an idea</a>
					<a class="pill pill-light" href="mailto:hello@mainframe.co?subject=Working%20at%20Mainframe">Come work here</a>
					<a class="pill pill-light" href="mailto:hello@mainframe.co?subject=Hello%20Mainframe">Send a brief hello</a>
					<a class="pill pill-light" href="#studio">See how we operate</a>
					<button class="pill pill-outline" type="button" data-copy-email aria-label="Copy hello@mainframe.co to clipboard"><span>Reach us: <span class="underline underline-offset-1">hello@mainframe.co</span></span><svg class="copy-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5.25" y="2.25" width="8.5" height="10.5" rx="1.25" stroke="currentColor" stroke-width="1.3"/><path d="M3.5 5v7.25c0 .69.56 1.25 1.25 1.25H10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></button>
				</div>
			</section>
		</main>
	</div>

	<script>
		const video = document.querySelector<HTMLVideoElement>("[data-scrub-video]");
		const typewriter = document.querySelector<HTMLElement>("[data-typewriter]");
		const cursor = document.querySelector<HTMLElement>("[data-type-cursor]");
		const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
		const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");
		const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");

		if (video) {
			let previousX: number | null = null;
			let targetTime = 0;
			let seekInProgress = false;
			const seekToTarget = () => {
				if (!video.duration || !Number.isFinite(video.duration) || seekInProgress || Math.abs(video.currentTime - targetTime) < 0.015) return;
				seekInProgress = true;
				try { video.currentTime = targetTime; } catch { seekInProgress = false; }
			};
			video.addEventListener("loadedmetadata", () => { targetTime = 0; seekToTarget(); });
			video.addEventListener("seeked", () => { seekInProgress = false; if (Math.abs(video.currentTime - targetTime) >= 0.015) seekToTarget(); });
			window.addEventListener("mousemove", (event) => {
				if (previousX === null) { previousX = event.clientX; return; }
				if (!video.duration || !Number.isFinite(video.duration)) return;
				const delta = event.clientX - previousX;
				previousX = event.clientX;
				targetTime = Math.max(0, Math.min(video.duration, targetTime + (delta / window.innerWidth) * 0.8 * video.duration));
				seekToTarget();
			});
		}

		if (typewriter && cursor) {
			const text = typewriter.dataset.text ?? "";
			let index = 0;
			window.setTimeout(() => {
				const timer = window.setInterval(() => {
					typewriter.textContent = text.slice(0, ++index);
					if (index >= text.length) { window.clearInterval(timer); cursor.hidden = true; }
				}, 38);
			}, 600);
		}

		if (menuToggle && mobileMenu) {
			const setMenu = (open: boolean) => {
				menuToggle.setAttribute("aria-expanded", String(open));
				menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
				mobileMenu.setAttribute("aria-hidden", String(!open));
				mobileMenu.toggleAttribute("inert", !open);
				mobileMenu.classList.toggle("is-open", open);
			};
			menuToggle.addEventListener("click", () => setMenu(menuToggle.getAttribute("aria-expanded") !== "true"));
			mobileMenu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
			window.addEventListener("keydown", (event) => { if (event.key === "Escape") setMenu(false); });
			window.matchMedia("(min-width: 768px)").addEventListener("change", () => setMenu(false));
		}

		if (copyButton) {
			copyButton.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText("hello@mainframe.co");
					copyButton.setAttribute("aria-label", "Email address copied");
					copyButton.classList.add("is-copied");
					window.setTimeout(() => { copyButton.setAttribute("aria-label", "Copy hello@mainframe.co to clipboard"); copyButton.classList.remove("is-copied"); }, 1600);
				} catch { copyButton.setAttribute("aria-label", "Clipboard unavailable. Email hello@mainframe.co"); }
			});
		}
	</script>
</Layout>
