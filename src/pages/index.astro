---
import Layout from "../layouts/Layout.astro";

const focusAreas = [
	{
		number: "01",
		title: "Deep Technology",
		copy: "Semiconductors, computing hardware, physical AI and robotics, energy, and electric vehicles. We back founders with defensible IP and real technical depth.",
		className: "deep-tech",
	},
	{
		number: "02",
		title: "AI Native Software",
		copy: "AI-native software built for global enterprises across infrastructure, applications, agents, vertical AI, and enterprise workflows.",
		className: "ai-software",
	},
	{
		number: "03",
		title: "B2B Platforms",
		copy: "Scalable B2B platforms built around mission-critical workflows, measurable customer value, and the potential to lead large global markets.",
		className: "b2b-platforms",
	},
];

const companies = ["mosaic", "Apt", "PIXiS", "moengage", "mCaffeine", "Ati", "EKA", "GIVA", "Exotel"];

const stories = [
	{ type: "SOCIAL", date: "FEB 28, 2026", title: "Exfinity at Inside India 2026: Engaging with a Senior Danish Delegation", art: "delegation" },
	{ type: "NEWS", date: "JAN 21, 2026", title: "Exfinity Venture Partners Unveils ₹1,100 Crore Fund IV for Deep-Tech Investments", art: "fund" },
	{ type: "NEWS", date: "JAN 15, 2026", title: "CloudSEK Becomes First Indian-Origin Cybersecurity Company to Receive Investment from a U.S. State Fund", art: "cloud" },
];
---

<Layout title="Exfinity Ventures — Backing Global Ambition">
	<main class="overflow-hidden">
		<section class="hero relative isolate min-h-[900px] overflow-hidden bg-[#00001c] text-white" id="top">
			<div class="hero-art" aria-hidden="true">
				<div class="chip"><span></span><span></span><span></span><span></span><span></span></div>
				<div class="hero-glow"></div>
			</div>
			<header class="site-header wrap mx-auto flex h-[88px] w-[calc(100%_-_40px)] max-w-[1440px] items-center justify-between sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<a class="brand brand-light" href="#top" aria-label="Exfinity Ventures home">
					<svg viewBox="0 0 48 24" aria-hidden="true"><path d="M2 12c5-10 11-10 17 0s12 10 17 0S43 2 47 12c-4 10-8 10-12 0S23 2 19 12 7 22 2 12Z" /></svg>
					<span>exfinity</span>
				</a>
				<nav class="nav-desktop" aria-label="Main navigation">
					<a href="#founders">For Founders</a>
					<a href="#portfolio">Portfolio</a>
					<a href="#team">The Team</a>
					<a href="#contact">Contact</a>
					<details class="menu-dropdown">
						<summary class="menu-trigger" aria-label="Open more links"><span></span><span></span></summary>
						<div class="menu-panel"><a href="#insights">Insights</a><a href="#newsletter">The Ledger</a><a href="#contact">Get in touch</a></div>
					</details>
				</nav>
			</header>
			<div class="hero-content wrap relative mx-auto flex min-h-[812px] w-[calc(100%_-_40px)] max-w-[1440px] flex-col justify-end pb-14 sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<p class="eyebrow hero-eyebrow">Independent thinkers. Enduring impact.</p>
				<div class="hero-bottom">
					<h1>Backing Global Ambition<br />Across Deep Technology, AI<br class="desktop-break" /> Native, and B2B Platforms</h1>
					<div class="hero-actions">
						<a class="button button-primary" href="#contact">Pitch to us <span>↗</span></a>
						<a class="button button-ghost" href="#portfolio">Portfolio <span>→</span></a>
					</div>
				</div>
				<div class="hero-scroll"><span class="scroll-line"></span>Scroll to explore</div>
			</div>
		</section>

		<section class="stats dark-section bg-[#03031d] text-white" aria-labelledby="stats-title">
			<div class="wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<div class="section-heading stats-heading">
					<p class="eyebrow">Our numbers</p>
					<h2 id="stats-title">Conviction, Proven in Numbers</h2>
				</div>
				<div class="stat-grid">
					<article><strong>$130M</strong><span>Deployed across three funds</span></article>
					<article><strong>$4.5B+</strong><span>Enterprise value created across the portfolio</span></article>
					<article><strong>300+</strong><span>Patents filed across the portfolio</span></article>
				</div>
			</div>
		</section>

		<section class="focus-section section-pad py-[82px] lg:py-[124px]" id="founders">
			<div class="wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<div class="focus-intro">
					<div><p class="eyebrow eyebrow-blue">What we back</p><h2>We invest across<br />three areas.</h2></div>
					<div class="intro-copy"><p>Each demands deep expertise to build and has the potential to create durable advantage at scale.</p><a class="text-link" href="#portfolio">View portfolio <span>↗</span></a></div>
				</div>
				<div class="focus-grid">
					{focusAreas.map((area) => (
						<article class={`focus-card ${area.className}`}>
							<div class="focus-art" aria-hidden="true"><span class="art-grid"></span><span class="art-orb"></span><span class="art-beam"></span><span class="focus-number">{area.number}</span></div>
							<div class="focus-card-copy"><h3>{area.title}</h3><p>{area.copy}</p><a href="#contact" aria-label={`Learn more about ${area.title}`}>↗</a></div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="process-section" aria-labelledby="process-title">
			<div class="wrap process-wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<div class="process-heading"><p class="eyebrow eyebrow-blue">Our approach</p><h2 id="process-title">How We Invest</h2><p>Where technical depth meets early conviction. We partner with founders from the first signal to global scale.</p></div>
				<div class="process-line" aria-hidden="true"></div>
				<div class="process-steps">
					<article class="process-step active"><span class="step-index">01 / Stage</span><div class="step-circle"><span class="step-label">Lead</span><span>Seed to Series A</span></div><p>We lead or co-lead early rounds with conviction.</p></article>
					<article class="process-step"><span class="step-index">02 / Partnership</span><div class="step-circle"><span class="step-label">Commit</span><span>Beyond the cheque</span></div><p>We work shoulder to shoulder through the hard parts.</p></article>
					<article class="process-step"><span class="step-index">03 / Ambition</span><div class="step-circle"><span class="step-label">Partner</span><span>Board Participation</span></div><p>We help build companies with the ambition to lead.</p></article>
				</div>
			</div>
		</section>

		<section class="portfolio section-pad py-[82px] lg:py-[124px]" id="portfolio">
			<div class="wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<div class="portfolio-top"><div><p class="eyebrow eyebrow-blue">Our portfolio</p><h2>Companies We Back</h2></div><a class="text-link" href="#portfolio-wall">See all companies <span>↗</span></a></div>
				<div class="portfolio-layout" id="portfolio-wall">
					<div class="company-wall" aria-label="Selected portfolio companies">{companies.map((company, index) => <div class={`company-logo logo-${index + 1}`}>{company}</div>)}</div>
					<article class="portfolio-feature"><div class="portfolio-image"><span class="server-stack" aria-hidden="true"></span><span class="image-caption">Infrastructure for what’s next</span></div><div class="portfolio-feature-copy"><p class="eyebrow eyebrow-blue">Portfolio spotlight</p><h3>Building technology for a more connected world.</h3><p>We partner with category-defining teams solving the hardest problems in global markets.</p><a class="text-link" href="#contact">Explore our portfolio <span>↗</span></a></div></article>
				</div>
			</div>
		</section>

		<section class="founders dark-section bg-[#02031a] text-white" id="team">
			<div class="founder-orbit" aria-hidden="true"></div>
			<div class="wrap founders-wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<p class="eyebrow">Founder stories</p><h2>What Our Founders Say</h2>
				<div class="founder-portraits" aria-hidden="true"><span class="portrait portrait-one">AM</span><span class="portrait portrait-two">RK</span><span class="portrait portrait-main">SM</span><span class="portrait portrait-four">NS</span><span class="portrait portrait-five">VP</span></div>
				<p class="founder-name">Shubham Mishra <span>Founder &amp; CEO</span></p>
				<blockquote>“They were our first investors and they stayed with us through several product pivots. Chinnu introduced us to our first major customer, which is now a million-dollar account.”</blockquote>
				<a class="text-link light-link" href="#contact">Meet our founders <span>↗</span></a>
			</div>
		</section>

		<section class="ledger section-pad bg-[#02031a] py-[82px] text-white lg:py-[124px]" id="insights">
			<div class="wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<div class="ledger-heading"><div><p class="eyebrow">Insights</p><h2>The Ledger</h2></div><div class="ledger-summary"><p>Research, market perspectives, portfolio updates, and conversations with founders building across deep tech and AI.</p><a class="text-link light-link" href="#newsletter">View all <span>↗</span></a></div></div>
				<div class="story-grid">
					{stories.map((story) => <article class="story-card"><div class={`story-art ${story.art}`} aria-hidden="true"><span></span></div><div class="story-meta"><span>{story.type}</span><time>{story.date}</time></div><h3>{story.title}</h3><a href="#newsletter" aria-label={`Read: ${story.title}`}>↗</a></article>)}
				</div>
			</div>
		</section>

		<section class="newsletter section-pad bg-white py-[82px] lg:py-[124px]" id="newsletter">
			<div class="wrap newsletter-wrap mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
				<div class="newsletter-art" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
				<div class="newsletter-content"><p class="eyebrow eyebrow-blue">Subscribe to the Ledger</p><h2>One Email a Month<br />From the Frontier</h2><p>What we are seeing, what we are backing, and what we are reading across Indian deep tech and AI.</p><form class="subscribe-form"><label class="sr-only" for="email">Email address</label><input id="email" name="email" type="email" placeholder="Enter Your Email Address" /><button type="submit">Subscribe <span>↗</span></button></form></div>
			</div>
		</section>
	</main>
	<footer class="site-footer" id="footer">
		<div class="wrap footer-main mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]">
			<div class="footer-brand"><a class="brand brand-blue" href="#top" aria-label="Exfinity Ventures home"><svg viewBox="0 0 48 24" aria-hidden="true"><path d="M2 12c5-10 11-10 17 0s12 10 17 0S43 2 47 12c-4 10-8 10-12 0S23 2 19 12 7 22 2 12Z" /></svg><span>exfinity</span></a><p>Backing global ambition.</p></div>
			<div class="footer-column"><span>Quick links</span><a href="#founders">For Founders</a><a href="#team">The Team</a><a href="#portfolio">Capital</a><a href="#portfolio">Portfolio</a><a href="#contact">LP Sign In</a></div>
			<div class="footer-column"><span>Legal</span><a href="#footer">Terms &amp; Conditions</a><a href="#footer">Privacy Policy</a><a href="#footer">AIF Registration Details</a></div>
			<div class="footer-column"><span>Company</span><a href="#insights">Insights</a><a href="#contact">Contact Us</a></div>
			<div class="footer-contact" id="contact"><span>Contact</span><p>+91 80 6847 4100</p><a href="mailto:info@exfinityventures.com">info@exfinityventures.com</a><address>10, Museum Rd, Shanthala Nagar,<br />Ashok Nagar, Bengaluru, Karnataka 560001</address></div>
		</div>
		<div class="wrap footer-bottom mx-auto w-[calc(100%_-_40px)] max-w-[1440px] sm:w-[calc(100%_-_64px)] xl:w-[calc(100%_-_112px)]"><span>©2026 Exfinity. All rights reserved.</span><span>Independent thinkers. Enduring impact.</span><a href="#top">Back to top ↑</a></div>
	</footer>
</Layout>

<script>
	import Lenis from "lenis";
	import "lenis/dist/lenis.css";

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (!reduceMotion) {
		const lenis = new Lenis({
			autoRaf: true,
			anchors: true,
			smoothWheel: true,
			lerp: 0.1,
		});

		const heroArt = document.querySelector<HTMLElement>(".hero-art");
		lenis.on("scroll", ({ scroll }) => {
			if (heroArt) heroArt.style.setProperty("--hero-shift", `${Math.min(scroll * 0.06, 48)}px`);
		});
	}

	const revealSelector = [
		".hero-eyebrow", ".hero h1", ".hero-actions", ".stats-heading", ".stat-grid article",
		".focus-intro", ".focus-card", ".process-heading", ".process-step", ".portfolio-top",
		".portfolio-layout", ".founder-portraits", ".founder-name", ".founders blockquote",
		".ledger-heading", ".story-card", ".newsletter-content", ".footer-main > *", ".footer-bottom",
	].join(",");
	const revealTargets = [...document.querySelectorAll<HTMLElement>(revealSelector)];

	if (!reduceMotion && "IntersectionObserver" in window) {
		document.documentElement.classList.add("motion-ready");
		const observer = new IntersectionObserver((entries, currentObserver) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add("is-visible");
					currentObserver.unobserve(entry.target);
				}
			}
		}, { threshold: 0.14, rootMargin: "0px 0px -35px 0px" });

		revealTargets.forEach((target, index) => {
			target.dataset.reveal = "";
			target.style.setProperty("--reveal-delay", `${(index % 4) * 85}ms`);
			observer.observe(target);
		});
	}
</script>
